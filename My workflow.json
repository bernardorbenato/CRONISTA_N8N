    {
      "parameters": {
        "jsCode": "const text = $input.item.json.text;\nconst chunks = [];\n\nfor (let i = 0; i < text.length; i += 1900) {\n  chunks.push(text.slice(i, i + 1900));\n}\n\nwhile (chunks.length < 3) {\n  chunks.push('');\n}\n\nreturn [{\n  json: {\n    text: text,\n    chunks: chunks\n  }\n}];"
